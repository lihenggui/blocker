<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service
            android:name="com.merxury.blocker.core.privileged.wake.WakeFixtureService"
            android:exported="false"
            android:process=":wake_fixture" />
        <service
            android:name="com.merxury.blocker.core.privileged.wake.UserWakeFixtureService"
            android:exported="true"
            tools:ignore="ExportedService" />
        <activity
            android:name="com.merxury.blocker.core.privileged.IfwFixtureActivity"
            android:exported="true" />
        <activity
            android:name="com.merxury.blocker.core.privileged.HiddenFixtureActivity"
            android:exported="false" />
        <activity
            android:name="com.merxury.blocker.core.control.ControlFixtureActivity"
            android:exported="true" />
        <activity
            android:name="com.merxury.blocker.core.control.ControlFixtureDisabledActivity"
            android:enabled="false"
            android:exported="true" />
        <provider
            android:name="com.merxury.blocker.core.control.ControlFixtureProvider"
            android:authorities="${applicationId}.controlfixture"
            android:exported="false" />
        <service
            android:name="com.merxury.blocker.core.appcontrol.AppControlFixtureService"
            android:exported="true"
            android:process=":app_control_fixture"
            tools:ignore="ExportedService" />
    </application>
</manifest>
