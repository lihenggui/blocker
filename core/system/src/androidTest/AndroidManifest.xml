<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Declarations for LocalSystemPackageReaderDeviceTest to read back. Nothing starts them. -->
    <application tools:ignore="MissingClass">
        <activity
            android:name="com.merxury.blocker.core.system.fixture.TargetActivity"
            android:exported="false" />
        <activity-alias
            android:name="com.merxury.blocker.core.system.fixture.Alias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity="com.merxury.blocker.core.system.fixture.TargetActivity" />
        <service
            android:name="com.merxury.blocker.core.system.fixture.DisabledByResourceService"
            android:enabled="@bool/core_system_fixture_disabled"
            android:exported="false" />
        <receiver
            android:name="com.merxury.blocker.core.system.fixture.EnabledReceiver"
            android:exported="true" />
        <provider
            android:name="com.merxury.blocker.core.system.fixture.FixtureProvider"
            android:authorities="com.merxury.blocker.core.system.fixture"
            android:enabled="false"
            android:exported="false" />
    </application>
</manifest>
