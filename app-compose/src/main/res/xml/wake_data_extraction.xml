        <exclude domain="database" path="wake_history-journal" />
        <exclude domain="sharedpref" path="wake_protection.xml" />
        <exclude domain="sharedpref" path="wake_stats_owner.xml" />
        <exclude domain="sharedpref" path="wake_reviewed_sdk.xml" />
    </device-transfer>
